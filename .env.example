# Скопируйте в .env. Файл .env не коммитится.
# Аргументы CLI перекрывают переменные окружения.

# --- Цель ---

# Профиль, сгенерированный командой red-alert inspect.
RED_ALERT_PROFILE=stand-profile.yaml

# Имена переменных с bearer-токенами задаются полями bearer_env самого профиля.
# TARGET_BEARER=target-token
# EVAL_BEARER=eval-token

# --- Планировщик атак (Red Alert ходит в LLM сам) ---
# --- LLM планировщика атак и LLM-судьи ---

OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL_ATTACK=https://openrouter.ai/api/v1
MODEL_ATTACK=openai/gpt-5-mini

OPENAI_BASE_URL_JUDGE=https://openrouter.ai/api/v1
MODEL_JUDGE=openai/gpt-5.4-mini

MAX_TOKENS=2048

# Каталог YAML-атак. По умолчанию ./attacks
# RED_ALERT_ATTACKS_DIR=attacks

# Изоляция попыток: on | off. По умолчанию on — выполнить reset из профиля.
# off оставляет накопленную память; CLI пишет warning, ASR не независим.
# RED_ALERT_ISOLATE=off

# Полный лог шагов: 1 / true / yes / on. Или флаг --debug.
# RED_ALERT_DEBUG=1

# --- Langfuse (локальный compose) ---
# Поднять UI: docker compose up -d
# Без RED_ALERT_LANGFUSE ключи ниже ничего не включают.
# RED_ALERT_LANGFUSE=1
# LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
# LANGFUSE_SECRET_KEY=sk-lf-local-dev
# LANGFUSE_BASE_URL=http://localhost:3000

# JSON с трейсами успешных атак:
#   uv run red-alert attack --output attack-report.json
#   uv run red-alert attack --debug --output attack-report.json
