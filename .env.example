# Скопируйте в .env. Файл .env не коммитится.
# Аргументы CLI перекрывают переменные стенда.

# --- Стенд ---

# Базовый URL agent-api. Суффикс /v1/chat/completions можно не писать.
RED_ALERT_TARGET=http://localhost:8600

# Bearer атакующего, например client1001.
RED_ALERT_API_KEY=sk-attacker

# Bearer жертвы, например client1002. Должен отличаться от ключа атакующего.
RED_ALERT_VICTIM_API_KEY=sk-victim

# --- Подготовка ключей (script/fetch_stand_keys.py) ---
# После переподнятия стенда:
#   uv run python script/fetch_stand_keys.py
# Скрипт логинится в Keycloak, выпускает ключи и перезаписывает две строки выше.
# Значения ниже — учебный стенд (публичные демо-секреты, не боевые).

# RED_ALERT_KEYCLOAK_URL=http://localhost:8180
# RED_ALERT_KEYCLOAK_REALM=genai-stand
# RED_ALERT_KEYCLOAK_CLIENT_ID=streamlit-ui
# RED_ALERT_KEYCLOAK_CLIENT_SECRET=streamlit-ui-secret
# RED_ALERT_STAND_USERS=client1001,client1002
# Третий и далее пользователи попадут в RED_ALERT_USER_<login>_API_KEY.
# RED_ALERT_STAND_PASSWORD=

# --- Планировщик атак (Red Alert ходит в LLM сам) ---

OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL=openai/gpt-5-mini
MAX_TOKENS=2048

# Каталог YAML-атак. По умолчанию ./attacks
# RED_ALERT_ATTACKS_DIR=attacks

# Режим стенда: vulnerable | protected | both. По умолчанию vulnerable.
# both — каждый сценарий сначала в дырявом режиме, потом в защищённом.
# RED_ALERT_AUTH_MODE=both

# Изоляция попыток: on | off. По умолчанию on — reset памяти стенда до каждой попытки.
# off оставляет накопленную память; CLI пишет warning, ASR не независим.
# RED_ALERT_ISOLATE=off

# Полный лог шагов: 1 / true / yes / on. Или флаг --debug.
# RED_ALERT_DEBUG=1

# --- Langfuse (локальный compose) ---
# Поднять UI: docker compose up -d
# Без RED_ALERT_LANGFUSE ключи ниже ничего не включают.
# RED_ALERT_LANGFUSE=1
# LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
# LANGFUSE_SECRET_KEY=sk-lf-local-dev
# LANGFUSE_BASE_URL=http://localhost:3000

# JSON с трейсами успешных атак:
#   uv run red-alert attack --output attack-report.json
#   uv run red-alert attack --debug --output attack-report.json
