# Скопируйте в .env. Файл .env не коммитится.
# Аргументы CLI перекрывают переменные стенда.

# --- Стенд ---

# Базовый URL agent-api. Суффикс /v1/chat/completions можно не писать.
RED_ALERT_TARGET=http://localhost:8600

# Bearer атакующего, например client1001.
RED_ALERT_API_KEY=sk-attacker

# Bearer жертвы, например client1002. Должен отличаться от ключа атакующего.
RED_ALERT_VICTIM_API_KEY=sk-victim

# --- Планировщик атак (Red Alert ходит в LLM сам) ---

OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL=openai/gpt-5-mini
MAX_TOKENS=2048

# Каталог YAML-атак. По умолчанию ./attacks
# RED_ALERT_ATTACKS_DIR=attacks

# Режим стенда: vulnerable | protected | both. По умолчанию vulnerable.
# both — каждый сценарий сначала в дырявом режиме, потом в защищённом.
# RED_ALERT_AUTH_MODE=both

# Полный лог шагов: 1 / true / yes / on. Или флаг --debug.
# RED_ALERT_DEBUG=1

# JSON с трейсами успешных атак:
#   uv run red-alert attack --output attack-report.json
#   uv run red-alert attack --debug --output attack-report.json
